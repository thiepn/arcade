{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-arcade-leaderboards",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://thiepn.github.io,http://localhost:3000,http://127.0.0.1:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micro-arcade-leaderboards",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "GUEST_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SCORE_RATE_LIMITER",
      "namespace_id": "41003",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
